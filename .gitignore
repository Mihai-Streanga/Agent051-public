# Secrets - never in Git
.env
.env.*
!.env.example

# Keys and credentials, in any form
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
token*.json

# Local data: the SQLite database and everything the program generates
data/

# Virtual environments and packages
.venv/
venv/
env/
node_modules/

# Python generated files
__pycache__/
*.pyc

# Build output and tool caches
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
logs/
*.log

# Temporary files
tmp-*
*.tmp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local editor settings
.vscode/
.idea/
.claude/settings.local.json
*.swp
*~
