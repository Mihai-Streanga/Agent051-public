# Model pentru fisierul .env (care NU se urca in Git).
# Copiaza acest fisier ca .env si completeaza valorile reale.
#
# GMAIL_APP_PASSWORD nu este parola contului Google, ci o "parola de aplicatie"
# generata separat din setarile de securitate Google.

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_FOLDER=Joburi


# --- Modelul (adapters/model.py) ---
#
# Din faza 2, agentul e AUTONOM: are cheie proprie si isi injecteaza singur
# functia care vorbeste cu modelul. JA.S.Mine nu mai injecteaza nimic - ea consuma
# doar faptele deja calculate. Planul cu injectia prin MCP a picat: MCP lasa
# clientul sa CHEME unelte, nu sa INJECTEZE functii, iar "sampling" din
# specificatie nu e suportat in Open WebUI si oricum ar inversa dependenta.
#
# ANTHROPIC_API_KEY: cheia proprie a agentului. O citeste UN SINGUR fisier -
# adapters/model.py. Lasata goala, normalizarea si evaluarea calitativa se opresc
# INAINTE de primul anunt, cu EroareInfrastructura, si nu scriu nimic in baza - un
# "n-am ajuns la model" nu se scrie niciodata ca "modelul a zis nu". Uneltele
# deterministe (ingestie, extragere, filtrare, briefing) merg mai departe - ele nu
# ating niciun model.
ANTHROPIC_API_KEY=your_api_key_here

# MODEL_NORMALIZARE: ce model foloseste adapters/model.py, pentru AMBELE etape cu
# model (normalizare si evaluare calitativa - numele variabilei e istoric). Acelasi
# nume ca `model` din config/cost.yaml, altfel raportul de cost spune "pret
# necunoscut".
# Fara valoare implicita: lasata goala, rularile cu model se opresc, ca la cheie.
MODEL_NORMALIZARE=claude-sonnet-5


# --- Serverul MCP (adapters/mcp_server.py) ---
#
# MCP_HOST: pe ce adresa asculta. Implicit 0.0.0.0 = toate interfetele.
# NU pune 127.0.0.1 daca clientul ruleaza in Docker: din container, "localhost"
# inseamna containerul insusi, nu masina ta, si serverul i-ar fi invizibil.
MCP_HOST=0.0.0.0
MCP_PORT=8051

# MCP_TOKEN: secretul cerut la fiecare cerere, ca "Authorization: Bearer <token>".
#
# OBLIGATORIU: fara el, serverul refuza sa porneasca. MCP_HOST e 0.0.0.0, deci
# serverul e vizibil pe toata reteaua locala; fara token, oricine ajunge la portul
# 8051 ar putea chema ingesteaza(), care iti citeste Gmail-ul.
#
# Completat, serverul respinge cu 401 orice cerere fara antetul corect.
# Genereaza-l cu:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Aceeasi valoare trebuie pusa si in configurarea clientului MCP (JA.S.Mine).
MCP_TOKEN=your_mcp_token_here
